# Copiá este archivo como ".env" y completá tus valores reales.
# ".env" está en .gitignore: NO lo subas nunca.

# API key de Riot (empieza con RGAPI-)
RIOT_API_KEY=RGAPI-completar-con-tu-key

# Servidor de tu cuenta (LAS = la2, LAN = la1). Ajustalo al tuyo.
RIOT_PLATFORM=la2

# Región de enrutamiento para cuenta y partidas (Américas)
RIOT_REGION=americas